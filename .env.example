# Server (Render Web Service)
NODE_ENV=production
PORT=10000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
FRONTEND_ORIGINS=https://YOUR_FRONTEND.onrender.com,http://localhost:5173
SETUP_SECRET=generate-a-random-secret-at-least-16-characters
CRON_SECRET=generate-a-different-random-secret-at-least-24-characters
IP_HASH_SECRET=generate-another-random-secret-at-least-16-characters
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NPG Autoparts - PartCast
BACKUP_RETENTION_DAYS=30
PYTHON_BIN=/opt/partcast-venv/bin/python

# Frontend (Render Static Site build variables)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL=https://YOUR_API.onrender.com
